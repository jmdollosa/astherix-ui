{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@jm/ui theme",
  "description": "Theme settings for @jm/ui. Turn into CSS with `npx jm-ui theme`, or apply at runtime with <ThemeProvider>.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "A hex color. Hover, pressed and dark-mode shades are worked out from it."
            },
            {
              "type": "object",
              "required": [
                "light"
              ],
              "additionalProperties": false,
              "properties": {
                "light": {
                  "type": "string",
                  "description": "The color in light mode (hex)."
                },
                "dark": {
                  "type": "string",
                  "description": "The color in dark mode. Worked out from light if left out."
                },
                "foreground": {
                  "type": "string",
                  "description": "Text and icons on the color in light mode."
                },
                "darkForeground": {
                  "type": "string",
                  "description": "Text and icons on the color in dark mode."
                }
              }
            }
          ],
          "description": "Buttons, links, focus rings and selected states."
        },
        "secondary": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "A hex color. Hover, pressed and dark-mode shades are worked out from it."
            },
            {
              "type": "object",
              "required": [
                "light"
              ],
              "additionalProperties": false,
              "properties": {
                "light": {
                  "type": "string",
                  "description": "The color in light mode (hex)."
                },
                "dark": {
                  "type": "string",
                  "description": "The color in dark mode. Worked out from light if left out."
                },
                "foreground": {
                  "type": "string",
                  "description": "Text and icons on the color in light mode."
                },
                "darkForeground": {
                  "type": "string",
                  "description": "Text and icons on the color in dark mode."
                }
              }
            }
          ],
          "description": "Second accent (e.g. Switch color=\"secondary\")."
        },
        "tertiary": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "A hex color. Hover, pressed and dark-mode shades are worked out from it."
            },
            {
              "type": "object",
              "required": [
                "light"
              ],
              "additionalProperties": false,
              "properties": {
                "light": {
                  "type": "string",
