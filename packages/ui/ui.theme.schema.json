                },
                "foreground": {
                  "type": "string",
                  "description": "Text and icons on the color in light mode."
                },
                "darkForeground": {
                  "type": "string",
                  "description": "Text and icons on the color in dark mode."
                }
              }
            }
          ]
        },
        "warning": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "A hex color. Hover, pressed and dark-mode shades are worked out from it."
            },
            {
              "type": "object",
              "required": [
                "light"
              ],
              "additionalProperties": false,
              "properties": {
                "light": {
                  "type": "string",
                  "description": "The color in light mode (hex)."
                },
                "dark": {
                  "type": "string",
                  "description": "The color in dark mode. Worked out from light if left out."
                },
                "foreground": {
